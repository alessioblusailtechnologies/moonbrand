SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
MEDIA_BUCKET=presenza-media

API_PORT=3012
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4200
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cartella dei file dei brand (default: moonbrand/moonbrand-brands)
BRANDS_DIR=
# Chiave per firmare i link ai file (default: SUPABASE_SERVICE_ROLE_KEY)
FILES_SECRET=

# Dettatura nella casella dell'assistente: Voxtral di Mistral (console.mistral.ai). Senza chiave il microfono dice che non è configurato.
MISTRAL_API_KEY=

# Collegamento dei social dei brand: Zernio (zernio.com, chiave sk_...). Senza chiave Collega dice che non è configurato.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
# Dove si può tornare dopo il collegamento: le origini di studio, separate da virgole (vuoto: qualsiasi http/https).
STUDIO_ORIGINS=
# Solo in collaudo/sviluppo: «Simula connessione» sui canali, i post dei canali simulati risultano pubblicati senza uscire.
SIMULATE_SOCIAL=false
