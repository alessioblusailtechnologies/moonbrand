DATABASE_URL=
WORKER_CONCURRENCY=2
# Cartella dei file dei brand (default: moonbrand/moonbrand-brands)
BRANDS_DIR=
GEMINI_API_KEY=
# ElevenLabs: voce fuori campo, effetti sonori, musica e canzoni.
ELEVENLABS_API_KEY=
# Atlas Cloud: le clip dei video (Gemini Omni Flash, 720p, circa 0,13 $ al secondo).
ATLASCLOUD_API_KEY=
# Zernio (la stessa chiave di moonbrand-api): scarica i post social che l'utente incolla come riferimento. Solo piani a pagamento.
ZERNIO_API_KEY=
# Il tetto di spesa per le clip di una conversazione, in dollari (default 3).
MOONBRAND_CLIP_BUDGET_USD=
# Dove i tool della chat chiamano moonbrand-api (default: http://localhost:3012)
API_URL=
