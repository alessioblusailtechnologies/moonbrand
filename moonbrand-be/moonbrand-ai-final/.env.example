# Il DB di moonbrand (Postgres su Supabase): la coda dei lavori e i risultati.
DATABASE_URL=
# Quanti lavori insieme (circa 4 GB di RAM per lavoro) e il nome di questo worker, che deve restare lo stesso tra un riavvio e l'altro.
WORKER_CONCURRENCY=2
WORKER_ID=
# Dove stanno le copie di lavoro delle cartelle dei brand (default: moonbrand/moonbrand-brands).
BRANDS_DIR=
# Dove i tool della chat chiamano moonbrand-api (default: http://localhost:3012).
API_URL=

# Il modello di Claude per tutti i lavori (default: claude-opus-5-5).
CLAUDE_MODEL=

# Gemini: le immagini generate e il motore di visione (guarda).
GEMINI_API_KEY=
# ElevenLabs: voce fuori campo, musica, canzoni ed effetti sonori dei video.
ELEVENLABS_API_KEY=
# Atlas Cloud: le clip generate dei video (Kling 3.0 Pro e Gemini Omni Flash, circa 14 crediti al secondo).
ATLASCLOUD_API_KEY=
# Il tetto in dollari per le clip di un lavoro dello studio (default 3); in chat non c'è, l'utente conferma la stima.
MOONBRAND_CLIP_BUDGET_USD=

# I file dei brand su Supabase Storage (protocollo S3); senza S3_ENDPOINT restano solo sul disco.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BRANDS_BUCKET=

# Le chiavi AWS per esportare i video su Remotion Lambda stanno in .env.lambda (REMOTION_AWS_ACCESS_KEY_ID,
# REMOTION_AWS_SECRET_ACCESS_KEY, REMOTION_AWS_REGION); senza il file i video si esportano in locale.
