// Il sito su Cloudflare: le pagine statiche della build di Astro, con davanti worker/index.js
// (301 verso la / finale, cache e intestazioni di sicurezza).
// Deploy: npm run deploy (serve una volta npx wrangler login).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moonbrand-website",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
