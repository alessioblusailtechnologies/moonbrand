---
// Una pagina per ogni categoria di attività, con l'indirizzo nella lingua della pagina.
import Landing from '../../../components/Landing.astro';
import { CATEGORIES, CATEGORY_IDS, type Category } from '../../../i18n';

export function getStaticPaths() {
  return CATEGORY_IDS.map((page) => ({ params: { category: CATEGORIES[page].it }, props: { page } }));
}

const { page } = Astro.props as { page: Category };
---

<Landing lang="it" page={page} />
