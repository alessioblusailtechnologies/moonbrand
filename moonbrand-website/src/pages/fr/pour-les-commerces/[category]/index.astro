---
import Landing from '../../../../components/Landing.astro';
import { CATEGORIES, CATEGORY_IDS, type Category } from '../../../../i18n';

export function getStaticPaths() {
  return CATEGORY_IDS.map((page) => ({ params: { category: CATEGORIES[page].fr }, props: { page } }));
}

const { page } = Astro.props as { page: Category };
---

<Landing lang="fr" page={page} />
