---
import { getCopy, homePath, LANGS, pagePath, STUDIO_URL, type Lang, type Page } from '../i18n';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  /** La pagina corrente, perché il cambio lingua resti sulla stessa pagina. */
  page?: Page;
}

const { lang, page = 'home' } = Astro.props;
const { nav } = getCopy(lang);
// Le sezioni stanno nella home: dalla home scorrono e basta, dalle altre pagine ci tornano.
const home = homePath(lang);
---

<header>
  <div class="bar">
    <Logo lang={lang} />
    <nav>
      <a href={`${home}#piattaforma`}>{nav.platform}</a>
      <a href={`${home}#risultato`}>{nav.why}</a>
      <a href={`${home}#sistema`}>{nav.features}</a>
      <a href={`${home}#prova`}>{nav.trial}</a>
    </nav>
    <div class="actions">
      <nav class="langs" aria-label={nav.language}>
        {LANGS.map((other) => (
          <a href={pagePath(other, page)} hreflang={other} lang={other} aria-current={other === lang ? 'page' : undefined}>
            {other.toUpperCase()}
          </a>
        ))}
      </nav>
      <a href={`${STUDIO_URL}/login`} class="login">{nav.login}</a>
      <a href={`${home}#prova`} class="btn btn-dark cta">{nav.start}</a>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    max-width: 1240px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  nav { display: flex; gap: 26px; font-size: 14.5px; color: var(--text); flex-wrap: wrap; }
  .actions { display: flex; gap: 8px; align-items: center; font-size: 14.5px; }
  .langs { display: flex; gap: 2px; padding: 3px; border-radius: 999px; background: #F2F1EE; font-size: 12px; font-weight: 600; }
  .langs a { padding: 4px 8px; border-radius: 999px; color: var(--muted); }
  .langs a[aria-current='page'] { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(11, 19, 36, 0.12); }
  .login { padding: 8px 12px; }
  .cta { padding: 9px 16px; border-radius: 8px; }
  @media (max-width: 760px) {
    .bar > nav { display: none; }
  }
  @media (max-width: 420px) {
    .login { display: none; }
  }
</style>
