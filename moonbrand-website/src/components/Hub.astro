---
// Le pagine indice del menù: funzionalità, social e per chi. Un'introduzione, i riquadri delle pagine del gruppo,
// il prezzo di partenza e l'invito a iniziare.
import { AUDIENCES, FEATURES } from '../data/landings';
import { getCopy, pagePath, PLATFORM_IDS, type Lang } from '../i18n';
import Cards from './Cards.astro';
import Closing from './Closing.astro';
import PageShell from './PageShell.astro';

interface Props {
  lang: Lang;
  page: 'features' | 'social' | 'audiences';
}

const { lang, page } = Astro.props;
const { hubs, landings, platforms } = getCopy(lang);
const c = hubs[page];

const items =
  page === 'features'
    ? FEATURES.map((id) => ({ href: pagePath(lang, id), name: landings[id].name, card: landings[id].card }))
    : page === 'social'
      ? PLATFORM_IDS.map((id) => ({ href: pagePath(lang, id), name: platforms[id].name, card: platforms[id].card }))
      : AUDIENCES.map((id) => ({ href: pagePath(lang, id), name: landings[id].name, card: landings[id].card }));
---

<PageShell lang={lang} page={page} title={c.title} description={c.description} eyebrow={c.eyebrow} heading={c.heading} lead={c.lead}>
  <Cards items={items} />
  <Closing lang={lang} />
</PageShell>
