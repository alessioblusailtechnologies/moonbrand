---
import { getCopy, pagePath, STUDIO_URL, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { trial: t } = getCopy(lang);
---

<section id="prova" class="trial" data-screen-label="Form prova">
  <div class="inner">
    <div class="head">
      <h2 class="display">{t.title}</h2>
      <p>{t.sub}</p>
    </div>

    <!-- Il form apre la registrazione nello studio con i campi già scritti: lì si sceglie la password (o Google)
         e il brand aspetta l'onboarding. La lingua fa partire lo studio in quella del sito. -->
    <form class="form" method="get" action={`${STUDIO_URL}/register`}>
      <input type="hidden" name="lang" value={lang} />
      <label>{t.name}<input name="name" autocomplete="name" required /></label>
      <label>{t.email}<input type="email" name="email" autocomplete="email" required /></label>
      <label>{t.brand}<input name="brand" data-brand-input /></label>
      <label class="consent">
        <input type="checkbox" required />
        <span>{t.consent[0]}<a href={pagePath(lang, 'privacy')} target="_blank">{t.consent[1]}</a>{t.consent[2]}</span>
      </label>
      <button type="submit">{t.submit}</button>
      <p class="login">{t.hasAccount} <a href={`${STUDIO_URL}/login`}>{t.login}</a></p>
    </form>
  </div>
</section>

<script>
  const brandInputs = document.querySelectorAll<HTMLInputElement>('[data-brand-input]');

  // Il nome del brand scritto nell'hero e nel form resta lo stesso nei due campi.
  brandInputs.forEach((input) =>
    input.addEventListener('input', () => {
      brandInputs.forEach((other) => other !== input && (other.value = input.value));
    }),
  );
</script>

<style>
  .trial { padding: 0 24px clamp(96px, 11vw, 140px); }
  .inner { max-width: 620px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px; }
  .head { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
  h2 { font-size: clamp(36px, 4.4vw, 56px); }
  .head p { margin: 0; font-size: 16px; color: var(--muted); }

  .form { display: flex; flex-direction: column; gap: 18px; }
  label { display: flex; flex-direction: column; gap: 6px; font-size: 13.5px; font-weight: 500; }
  input:not([type='checkbox']) {
    height: 44px;
    border: 1px solid #DDDBD5;
    border-radius: 10px;
    padding: 0 12px;
    font-family: inherit;
    font-size: 15px;
    background: #fff;
    color: var(--ink);
  }
  input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .consent { flex-direction: row; gap: 10px; align-items: flex-start; font-size: 13px; font-weight: 400; line-height: 1.5; color: var(--muted); }
  .consent input { margin-top: 3px; }
  .consent a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  button {
    height: 50px;
    border: 0;
    border-radius: 10px;
    background: var(--ink);
    color: #fff;
    font-family: inherit;
    font-size: 15.5px;
    font-weight: 600;
    cursor: pointer;
  }
  button:hover { background: var(--ink-hover); }

  .login { margin: 0; text-align: center; font-size: 14px; color: var(--muted); }
  .login a { color: var(--ink); font-weight: 500; }
</style>
