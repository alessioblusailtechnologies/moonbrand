---
import { getCopy, homePath, pagePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { footer } = getCopy(lang);
---

<footer>
  <div class="inner">
    {footer.links.map((f, i) => (
      <a href={i === 0 ? `${homePath(lang)}#piattaforma` : '#'} class="big-link">{f}<span aria-hidden="true">→</span></a>
    ))}
    <div class="bottom">
      <span>{footer.copyright}</span>
      <div class="legal">
        <a href={pagePath(lang, 'privacy')}>{footer.privacy}</a>
        <a href={pagePath(lang, 'terms')}>{footer.terms}</a>
        <a href={pagePath(lang, 'contact')}>{footer.contact}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--ink); color: #fff; padding: 24px 24px 40px; }
  .inner { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; }
  .big-link { display: flex; justify-content: space-between; align-items: center; padding: 26px 0; border-bottom: 1px solid #1C2640; font-size: 17px; font-weight: 500; }
  .big-link span { color: #5E6A82; }
  .bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 28px; font-size: 13px; color: #7E8AA3; }
  .legal { display: flex; gap: 20px; }
</style>
