---
// Il piede: una colonna per ogni pagina indice del menù, con le sue pagine, più prezzi, contatti e accesso.
import { AUDIENCES, FEATURES } from '../data/landings';
import { CATEGORY_IDS, getCopy, pagePath, PLATFORM_IDS, STUDIO_URL, type Lang, type Page } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { footer, nav, landings, categories, platforms } = getCopy(lang);
const link = (page: Page, name: string) => ({ href: pagePath(lang, page), name });

const columns = [
  { title: link('features', nav.features), links: FEATURES.map((id) => link(id, landings[id].name)) },
  { title: link('social', nav.social), links: PLATFORM_IDS.map((id) => link(id, platforms[id].name)) },
  {
    title: link('audiences', nav.audiences),
    links: [...AUDIENCES.map((id) => link(id, landings[id].name)), ...CATEGORY_IDS.map((id) => link(id, categories[id].name))],
  },
  {
    title: link('home', 'Moonbrand'),
    links: [link('pricing', nav.pricing), link('contact', footer.contact), { href: `${STUDIO_URL}/login`, name: nav.login }],
  },
];
---

<footer>
  <div class="inner">
    <div class="columns">
      {columns.map((column) => (
        <nav aria-label={column.title.name}>
          <a href={column.title.href} class="title">{column.title.name}</a>
          {column.links.map((item) => <a href={item.href}>{item.name}</a>)}
        </nav>
      ))}
    </div>
    <div class="bottom">
      <span>{footer.copyright}</span>
      <div class="legal">
        <a href={pagePath(lang, 'privacy')}>{footer.privacy}</a>
        <a href={pagePath(lang, 'terms')}>{footer.terms}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--ink); color: #fff; padding: 64px 24px 40px; }
  .inner { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 56px; }
  .columns { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  nav { display: flex; flex-direction: column; gap: 12px; font-size: 14.5px; color: #A9B3C6; }
  .title { margin-bottom: 4px; font-size: 15px; font-weight: 600; color: #fff; }
  nav a:hover { color: var(--accent); }
  .bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 28px; border-top: 1px solid #1C2640; font-size: 13px; color: #7E8AA3; }
  .legal { display: flex; gap: 20px; }
  @media (max-width: 760px) {
    .columns { grid-template-columns: repeat(2, 1fr); gap: 40px 24px; }
  }
</style>
