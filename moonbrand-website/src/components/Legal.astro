---
// Privacy e termini: il testo arriva da iubenda alla build ed è impaginato come il resto del sito.
// Se l'API non risponde, resta il link al documento su iubenda.
import { iubendaId, iubendaText, iubendaUrl, type LegalKind } from '../data/iubenda';
import { CONTACT_EMAIL, getCopy, type Lang } from '../i18n';
import PageShell from './PageShell.astro';

interface Props {
  lang: Lang;
  kind: LegalKind;
}

const { lang, kind } = Astro.props;
const { legal } = getCopy(lang);
const id = iubendaId(kind, lang);
const privacy = kind === 'privacy';
const text = id ? await iubendaText(kind, id) : null;
---

<PageShell
  lang={lang}
  page={kind}
  title={privacy ? legal.privacyTitle : legal.termsTitle}
  description={privacy ? legal.privacyDescription : legal.termsDescription}
  heading={privacy ? legal.privacyHeading : legal.termsHeading}
  noindex={!id}
>
  {text ? (
    <div class="legal-doc" set:html={text} />
  ) : id ? (
    <p class="soon"><a href={iubendaUrl(kind, id)}>{legal.open}</a></p>
  ) : (
    <p class="soon">{legal.soon} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
  )}
</PageShell>

<style>
  .soon { margin: 0; font-size: 17px; line-height: 1.55; color: var(--text); }
  .soon a { color: var(--accent-dark); text-decoration: underline; }

  /* Il testo di iubenda: HTML semplice (titoli, paragrafi, elenchi, sezioni a scomparsa), con la tipografia del sito. */
  .legal-doc { font-size: 16px; line-height: 1.65; color: var(--text); overflow-wrap: anywhere; }
  .legal-doc :global(header) { margin-bottom: 8px; }
  .legal-doc :global(header p) { margin: 0 0 8px; font-size: 18px; }
  .legal-doc :global(header p:last-child) { font-size: 14px; color: var(--muted); }
  .legal-doc :global(h2) {
    margin: 56px 0 16px;
    font-family: var(--display);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(28px, 3.6vw, 36px);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .legal-doc :global(h3) { margin: 36px 0 10px; font-size: 20px; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
  .legal-doc :global(h4) { margin: 24px 0 6px; font-size: 16.5px; font-weight: 600; color: var(--ink); }
  .legal-doc :global(h5) { margin: 18px 0 4px; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .legal-doc :global(p) { margin: 0 0 12px; }
  .legal-doc :global(ul) { margin: 0 0 14px; padding-left: 20px; }
  .legal-doc :global(li) { margin: 4px 0; }
  .legal-doc :global(strong) { color: var(--ink); font-weight: 600; }
  .legal-doc :global(a) { color: var(--accent-dark); text-decoration: underline; text-underline-offset: 2px; }

  /* Il sommario: una scheda con i link alle sezioni. */
  .legal-doc :global(aside) { margin: 32px 0 8px; padding: 24px 28px; border: 1px solid var(--line); border-radius: 16px; background: #FAFAF8; }
  .legal-doc :global(aside h2) { margin: 0 0 12px; font-size: 22px; }
  .legal-doc :global(aside ul) { margin: 0; padding: 0; list-style: none; columns: 2 240px; column-gap: 32px; }
  .legal-doc :global(aside a) { color: var(--ink); text-decoration: none; }
  .legal-doc :global(aside a:hover) { color: var(--accent-dark); }

  /* Le schede di ogni servizio, a scomparsa. */
  .legal-doc :global(details) { margin: 10px 0; border: 1px solid var(--line); border-radius: 12px; background: #fff; }
  .legal-doc :global(summary) { padding: 14px 18px; cursor: pointer; font-weight: 600; color: var(--ink); }
  .legal-doc :global(summary *) { display: inline; margin: 0; font-size: 16px; }
  .legal-doc :global(details[open] summary) { border-bottom: 1px solid var(--line); }
  .legal-doc :global(details > :not(summary)) { padding: 0 18px; }
  .legal-doc :global(details > :last-child) { padding-bottom: 14px; }

  /* Il titolare e le schede finali ("Come possiamo aiutare?"). */
  .legal-doc :global(footer),
  .legal-doc :global(article) { margin-top: 32px; padding: 24px 28px; border-radius: 16px; background: #FAFAF8; border: 1px solid var(--line); }
  .legal-doc :global(footer h3),
  .legal-doc :global(article h3) { margin-top: 0; }
</style>
